# === Database (PostgreSQL) ===
# Prisma memakai dua URL:
#   DATABASE_URL  → koneksi runtime (aplikasi)
#   DIRECT_URL    → koneksi untuk migrasi (prisma migrate / db push)
#
# --- Opsi A: PostgreSQL lokal ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smaramedika?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smaramedika?schema=public"
#
# --- Opsi B: Supabase (Supavisor pooler) ---
# Ambil string dari Supabase Dashboard → Connect → ORMs/Prisma.
# Runtime  : transaction pooler (port 6543) + pgbouncer=true
# Migrasi  : session pooler (port 5432)
# Catatan  : URL-encode karakter spesial pada password (mis. '@' → '%40').
#            Koneksi direct (db.<ref>.supabase.co) bersifat IPv6-only di free tier — pakai pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# === Auth.js (NextAuth v5) ===
# Hasilkan secret acak, mis.: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_URL="http://localhost:3000"

# === SEO ===
# URL publik produksi untuk metadata absolut (OG image, canonical, sitemap, robots).
# Jika kosong, fallback ke AUTH_URL lalu http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://smaramedika.example.com"
