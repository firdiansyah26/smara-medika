# === Database (PostgreSQL) ===
# Ganti user, password, host, port, dan nama database sesuai lingkunganmu.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smaramedika?schema=public"

# === Auth (untuk fase berikutnya) ===
# Hasilkan secret acak, mis.: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-acak"
NEXTAUTH_URL="http://localhost:3000"
