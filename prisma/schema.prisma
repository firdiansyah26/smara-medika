// SmaraMedika — Skema Database (PostgreSQL)
// Mengacu pada docs/DATABASE.md. Platform multi-tenant: hampir semua entitas
// operasional memiliki tenantId untuk isolasi data.
//
// Konvensi: nama model (PascalCase) & field (camelCase) untuk Prisma Client,
// dipetakan ke nama tabel & kolom snake_case di DB via @@map / @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum TenantType {
  RUMAH_SAKIT
  KLINIK
  APOTEK

  @@map("tenant_type")
}

enum Role {
  OWNER
  ADMIN
  DOKTER
  PERAWAT
  RESEPSIONIS
  APOTEKER

  @@map("role")
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN

  @@map("gender")
}

enum BloodType {
  A
  B
  AB
  O

  @@map("blood_type")
}

enum EncounterStatus {
  MENUNGGU
  DIPERIKSA
  SELESAI

  @@map("encounter_status")
}

enum DiagnosisType {
  PRIMER
  SEKUNDER

  @@map("diagnosis_type")
}

enum AllergySeverity {
  RINGAN
  SEDANG
  BERAT

  @@map("allergy_severity")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED

  @@map("access_request_status")
}

enum PartnershipStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE

  @@map("partnership_status")
}

enum OrderStatus {
  REQUESTED
  CONFIRMED
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RECEIVED
  REJECTED
  CANCELLED

  @@map("order_status")
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN

  @@map("audit_action")
}

enum ApiKeyMode {
  LIVE
  TEST

  @@map("api_key_mode")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD_LETTER

  @@map("webhook_delivery_status")
}

enum ServiceType {
  BPJS
  ASURANSI
  UMUM

  @@map("service_type")
}

enum QueueStatus {
  WAITING
  CALLED
  SERVED
  SKIPPED

  @@map("queue_status")
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  CANCELLED

  @@map("invoice_status")
}

enum BillingCategory {
  CONSULTATION
  DRUG
  PROCEDURE
  LAB
  OTHER

  @@map("billing_category")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

// ============================================================
// Multi-tenant (fondasi)
// ============================================================

model Tenant {
  id        String     @id @default(cuid())
  name      String
  type      TenantType
  code      String     @unique
  address   String?
  city      String?
  phone     String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  memberships      Membership[]
  patients         Patient[]
  encounters       Encounter[]
  drugStocks       DrugStock[]
  prescriptions    Prescription[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  apiRequestLogs   ApiRequestLog[]
  auditLogs        AuditLog[]

  accessRequestsAsOwner     PatientAccessRequest[] @relation("AccessOwner")
  accessRequestsAsRequester PatientAccessRequest[] @relation("AccessRequester")
  partnershipsInitiated     TenantPartnership[]    @relation("PartnershipRequester")
  partnershipsReceived      TenantPartnership[]    @relation("PartnershipAddressee")
  ordersRequested           DrugOrder[]            @relation("OrderRequester")
  ordersSupplied            DrugOrder[]            @relation("OrderSupplier")
  queueTickets              QueueTicket[]
  invoices                  Invoice[]
  appointments              Appointment[]

  @@map("tenants")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  encounters          Encounter[]          @relation("EncounterDoctor")
  auditLogs           AuditLog[]
  appointments        Appointment[]        @relation("AppointmentDoctor")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  tenantId    String   @map("tenant_id")
  role        Role
  isActive    Boolean  @default(true) @map("is_active")
  invitedById String?  @map("invited_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

// ============================================================
// Klinis (scoped per tenant)
// ============================================================

model Patient {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  mrNumber         String     @map("mr_number")
  nik              String?
  name             String
  birthDate        DateTime   @map("birth_date")
  gender           Gender
  bloodType        BloodType? @map("blood_type")
  phone            String?
  address          String?
  city             String?
  emergencyContact String?    @map("emergency_contact")
  bpjsNumber       String?    @map("bpjs_number")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounters     Encounter[]
  allergies      Allergy[]
  accessRequests PatientAccessRequest[]
  invoices       Invoice[]
  appointments   Appointment[]

  @@unique([tenantId, mrNumber])
  @@index([nik])
  @@index([tenantId])
  @@map("patients")
}

model PatientAccessRequest {
  id                String              @id @default(cuid())
  patientId         String              @map("patient_id")
  ownerTenantId     String              @map("owner_tenant_id")
  requesterTenantId String              @map("requester_tenant_id")
  requestedById     String              @map("requested_by_id")
  respondedById     String?             @map("responded_by_id")
  reason            String?
  status            AccessRequestStatus @default(PENDING)
  expiresAt         DateTime?           @map("expires_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ownerTenant     Tenant  @relation("AccessOwner", fields: [ownerTenantId], references: [id])
  requesterTenant Tenant  @relation("AccessRequester", fields: [requesterTenantId], references: [id])

  @@index([ownerTenantId, status])
  @@index([requesterTenantId, status])
  @@map("patient_access_requests")
}

model Encounter {
  id         String          @id @default(cuid())
  tenantId   String          @map("tenant_id")
  patientId  String          @map("patient_id")
  doctorId   String          @map("doctor_id")
  visitDate  DateTime        @default(now()) @map("visit_date")
  status     EncounterStatus @default(MENUNGGU)
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        User           @relation("EncounterDoctor", fields: [doctorId], references: [id])
  vitalSign     VitalSign?
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  invoices      Invoice[]

  @@index([tenantId, visitDate])
  @@index([patientId])
  @@map("encounters")
}

model VitalSign {
  id              String @id @default(cuid())
  encounterId     String @unique @map("encounter_id")
  systolic        Int?
  diastolic       Int?
  temperature     Float?
  heartRate       Int?   @map("heart_rate")
  respiratoryRate Int?   @map("respiratory_rate")
  spo2            Int?
  weight          Float?
  height          Float?

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model Diagnosis {
  id          String        @id @default(cuid())
  encounterId String        @map("encounter_id")
  icdCode     String        @map("icd_code")
  icdName     String        @map("icd_name")
  type        DiagnosisType @default(PRIMER)
  notes       String?

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("diagnoses")
}

model Allergy {
  id        String           @id @default(cuid())
  patientId String           @map("patient_id")
  allergen  String
  reaction  String?
  severity  AllergySeverity?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("allergies")
}

// ============================================================
// Farmasi & transfer obat
// ============================================================

model Drug {
  id          String  @id @default(cuid())
  name        String
  genericName String? @map("generic_name")
  unit        String
  category    String?

  stocks            DrugStock[]
  prescriptionItems PrescriptionItem[]
  orderItems        DrugOrderItem[]

  @@map("drugs")
}

model DrugStock {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  drugId   String   @map("drug_id")
  quantity Int      @default(0)
  price    Decimal? @db.Decimal(12, 2)
  minStock Int?     @map("min_stock")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drug   Drug   @relation(fields: [drugId], references: [id])

  @@unique([tenantId, drugId])
  @@map("drug_stocks")
}

model Prescription {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  encounterId String   @map("encounter_id")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  items     PrescriptionItem[]

  @@index([encounterId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String  @map("prescription_id")
  drugId         String  @map("drug_id")
  dosage         String?
  frequency      String?
  quantity       Int     @default(1)
  instruction    String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug         Drug         @relation(fields: [drugId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_items")
}

model TenantPartnership {
  id                String            @id @default(cuid())
  requesterTenantId String            @map("requester_tenant_id")
  addresseeTenantId String            @map("addressee_tenant_id")
  status            PartnershipStatus @default(PENDING)
  requestedById     String            @map("requested_by_id")
  respondedById     String?           @map("responded_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  requesterTenant Tenant @relation("PartnershipRequester", fields: [requesterTenantId], references: [id])
  addresseeTenant Tenant @relation("PartnershipAddressee", fields: [addresseeTenantId], references: [id])

  @@unique([requesterTenantId, addresseeTenantId])
  @@map("tenant_partnerships")
}

model DrugOrder {
  id                String      @id @default(cuid())
  orderNumber       String      @unique @map("order_number")
  requesterTenantId String      @map("requester_tenant_id")
  supplierTenantId  String      @map("supplier_tenant_id")
  status            OrderStatus @default(REQUESTED)
  requestedById     String      @map("requested_by_id")
  note              String?
  totalAmount       Decimal?    @map("total_amount") @db.Decimal(14, 2)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  requesterTenant Tenant              @relation("OrderRequester", fields: [requesterTenantId], references: [id])
  supplierTenant  Tenant              @relation("OrderSupplier", fields: [supplierTenantId], references: [id])
  items           DrugOrderItem[]
  trackings       DrugOrderTracking[]

  @@index([requesterTenantId, status])
  @@index([supplierTenantId, status])
  @@map("drug_orders")
}

model DrugOrderItem {
  id       String   @id @default(cuid())
  orderId  String   @map("order_id")
  drugId   String   @map("drug_id")
  quantity Int
  price    Decimal? @db.Decimal(12, 2)

  order DrugOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  drug  Drug      @relation(fields: [drugId], references: [id])

  @@index([orderId])
  @@map("drug_order_items")
}

model DrugOrderTracking {
  id          String      @id @default(cuid())
  orderId     String      @map("order_id")
  status      OrderStatus
  note        String?
  changedById String?     @map("changed_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  order DrugOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("drug_order_trackings")
}

// ============================================================
// Audit
// ============================================================

model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String?     @map("tenant_id")
  userId    String      @map("user_id")
  action    AuditAction
  entity    String
  entityId  String?     @map("entity_id")
  changes   Json?
  ipAddress String?     @map("ip_address")
  createdAt DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// Shared API (integrasi pihak ketiga) — lihat docs/SHARED_API.md
// ============================================================

model ApiKey {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  name         String
  prefix       String       @unique
  hashedSecret String       @map("hashed_secret")
  mode         ApiKeyMode   @default(LIVE)
  scopes       String[]
  ipAllowlist  String[]     @map("ip_allowlist")
  status       ApiKeyStatus @default(ACTIVE)
  lastUsedAt   DateTime?    @map("last_used_at")
  expiresAt    DateTime?    @map("expires_at")
  createdById  String       @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  endpointId   String                @map("endpoint_id")
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  nextRetryAt  DateTime?             @map("next_retry_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@map("webhook_deliveries")
}

model QueueTicket {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  serviceType ServiceType @map("service_type")
  number      Int
  code        String
  status      QueueStatus @default(WAITING)
  counter     String?
  calledById  String?     @map("called_by_id")
  calledAt    DateTime?   @map("called_at")
  servedAt    DateTime?   @map("served_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("queue_tickets")
}

model ApiRequestLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  apiKeyId   String?  @map("api_key_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  latencyMs  Int?     @map("latency_ms")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("api_request_logs")
}

// ============================================================
// Billing (tagihan & invoice)
// ============================================================

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  patientId     String        @map("patient_id")
  encounterId   String?       @map("encounter_id")
  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)
  discount      Int           @default(0)
  total         Int           @default(0)
  note          String?
  createdById   String        @map("created_by_id")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id])
  encounter Encounter?    @relation(fields: [encounterId], references: [id])
  items     InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([patientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String          @map("invoice_id")
  category    BillingCategory @default(OTHER)
  description String
  quantity    Int             @default(1)
  unitPrice   Int             @default(0) @map("unit_price")
  amount      Int             @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================================
// Appointment (jadwal & janji temu)
// ============================================================

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  patientId   String            @map("patient_id")
  doctorId    String            @map("doctor_id")
  scheduledAt DateTime          @map("scheduled_at")
  durationMin Int               @default(30) @map("duration_min")
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  note        String?
  encounterId String?           @map("encounter_id")
  createdById String            @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation("AppointmentDoctor", fields: [doctorId], references: [id])

  @@index([tenantId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@map("appointments")
}

// ============================================================
// Reset kata sandi (token)
// ============================================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
